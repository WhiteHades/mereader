{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeReader",
  "version": "0.1.0",
  "identifier": "com.whitehades.mereader",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; img-src 'self' data: blob: asset:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "MeReader",
        "fullscreen": false,
        "height": 800,
        "minHeight": 600,
        "width": 1200,
        "minWidth": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Education",
    "longDescription": "MeReader - AI-enhanced ebook reader",
    "shortDescription": "MeReader",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
